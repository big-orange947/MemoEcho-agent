# 这个文件的作用是忽略本地开发、构建和运行时产生的临时文件，避免脏文件被提交到 GitHub。

# JetBrains / IDEA
.idea/
*.iml

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Python packaging
*.egg-info/
build/
dist/

# Java / Maven
target/
*.class

# Logs
*.log
logs/

# Local environment
.env
.env.*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime temp files
*.tmp
*.temp
.runtime/
scripts/local-env.ps1

# v2 runtime data: SQLite 业务库、LangGraph checkpoint、媒体缓存
# （数据可不入库；如需备份请单独拷 data/ 目录）
data/
*.sqlite3
*.sqlite3-*
