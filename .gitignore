venv/
env/

# Python packaging
*.egg-info/
build/
dist/

# Java / Maven
target/
*.class

# Logs
*.log
logs/

# Local environment
.env
.env.*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime temp files
*.tmp
*.temp
